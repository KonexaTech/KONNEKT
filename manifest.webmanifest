{
  "id": "./",
  "name": "KONNEKT \u2014 Connecting people everywhere",
  "short_name": "KONNEKT",
  "description": "Connect, chat, share status updates, discover people and watch Reels.",
  "start_url": "./?source=pwa",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#07050d",
  "theme_color": "#0b0715",
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./konnekt-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./konnekt-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./konnekt-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
