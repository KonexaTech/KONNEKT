{
  "name": "konnekt-real-world-test",
  "version": "0.1.0",
  "private": true,
  "description": "KONNEKT - Connecting people everywhere",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview",
    "build:mobile": "vite build --base=./",
    "cap:sync": "npm run build:mobile && npx cap sync",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios",
    "android:add": "npx cap add android",
    "android:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android:build:debug": "cd android && gradlew.bat assembleDebug",
    "lint": "eslint App.jsx main.jsx src sw.js",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node --test tests/browser/*.test.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^7.4.3",
    "@capacitor/app": "^7.0.2",
    "@capacitor/browser": "^7.0.2",
    "@capacitor/camera": "^7.0.2",
    "@capacitor/core": "^7.4.3",
    "@capacitor/filesystem": "^7.1.4",
    "@capacitor/haptics": "^7.0.2",
    "@capacitor/ios": "^7.0.2",
    "@capacitor/keyboard": "^7.0.3",
    "@capacitor/status-bar": "^7.0.2",
    "@supabase/supabase-js": "2.119.0",
    "onesignal-cordova-plugin": "^5.2.12",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native-web": "0.19.13"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.3",
    "@electric-sql/pglite": "0.5.16",
    "@vitejs/plugin-react": "4.3.4",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "https-proxy-agent": "9.1.0",
    "playwright": "1.65.1",
    "typescript": "^5.0.0",
    "vite": "6.4.6",
    "ws": "8.23.0"
  }
}
